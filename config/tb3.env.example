# tb3-companion の設定ファイル（PC 側）。
# `tb3ctl init` が対話で作る。手で作るなら、このファイルを config/tb3.env にコピーして書き換える。
# 置き場所の探し順: $TB3_CONFIG → ./config/tb3.env → ~/.config/tb3-companion/tb3.env

# ---- 機体 ----
# ssh と ROS 2 の相手。IP アドレスでも、mDNS の名前（例: turtlebot.local）でもよい。
# Wi-Fi が DHCP なら名前のほうが楽（PC が名前から IP を引いて DDS の設定に入れる）。
ROBOT_HOST=192.168.11.100
ROBOT_USER=ubuntu
# 機体に入る ssh 鍵（無ければ空。パスワードでも入れる）
ROBOT_SSH_KEY=

# ---- ROS 2 ----
# 機体と PC で必ず同じにする。複数台・複数人で同じネットワークを使うときは分ける（0〜101）
ROS_DOMAIN_ID=0
# rmw_fastrtps_cpp（既定）か rmw_cyclonedds_cpp
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# PC → 機体の発見のしかた:
#   unicast   = 機体の IP へ直接も呼びかける（Wi-Fi 越しはこちらがおすすめ。マルチキャストは遅い）
#   multicast = Fast DDS の既定のまま（有線・同じスイッチ上ならこれで十分）
DDS_MODE=unicast

# ---- 機体の構成（機体側の /etc/tb3/tb3.env に書き出される）----
TURTLEBOT3_MODEL=waffle_pi
LDS_MODEL=LDS-02
# 機体の ROS 2 が使うネットワークインタフェース。wlan0 / eth0 / any（制限しない）。
# wlan0 にすると、有線の抜き差しで通信が壊れない（Fast DDS を、その時点の wlan0 の IP だけに絞る）。
DDS_IFACE=wlan0
# 腕のサーボの加速・速度の上限（既定は ROBOTIS 純正の 100 / 500。25 / 300 だとなめらか）
JOINTS_PROFILE_ACCELERATION=25
JOINTS_PROFILE_VELOCITY=300

# ---- PC 側のサーバー ----
SERVER_PORT=8080
ROSBRIDGE_PORT=9090
# Windows のとき、ROS 2 Humble が入っている WSL のディストリビューション名（wsl -l で確認）
WSL_DISTRO=Ubuntu-22.04
