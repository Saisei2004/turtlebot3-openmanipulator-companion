+bool OpenCR::set_goal_positions(
+  const std::vector<double> & joint_radians, const double & gripper_meters)
+{
+  // goal_position_joint_1..4 (200..215), goal_position_gripper (216..219),
+  // goal_position_write_joints (220), goal_position_write_gripper (221) は連続している
+  uint8_t buffer[22];
+  int32_t ticks[5] = {0, 0, 0, 0, 0};
+  for (uint8_t i = 0; i < 4 && i < joint_radians.size(); i++) {
+    ticks[i] = convert_radian_to_tick(
+      joint_radians[i],
+      opencr::joints::MAX_TICK,
+      opencr::joints::MIN_TICK,
+      opencr::joints::MAX_RADIAN,
+      opencr::joints::MIN_RADIAN);
+  }
+  ticks[4] = convert_radian_to_tick(
+    gripper_meters / opencr::grippers::RAD_TO_METER,
+    opencr::joints::MAX_TICK,
+    opencr::joints::MIN_TICK,
+    opencr::joints::MAX_RADIAN,
+    opencr::joints::MIN_RADIAN);
+  std::memcpy(buffer, ticks, sizeof(ticks));
+  buffer[20] = 1;
+  buffer[21] = 1;
+
+  return dxl_sdk_wrapper_->write(
+    opencr_control_table.goal_position_joint_1.address, sizeof(buffer), buffer);
+}
