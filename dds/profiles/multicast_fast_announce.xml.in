<?xml version="1.0" encoding="UTF-8" ?>
<!--
  multicast_fast_announce — マルチキャスト発見のまま、最初の「ここにいます」の送り方を増やす。
  目的: Wi-Fi でマルチキャストが一部落ちても、発見が早くなるか（実験 B）。
  内容: 起動直後の発見の知らせを 100 ms 間隔で 20 回（既定は少ない回数・長い間隔）。
  注意: 参加者が多い環境では発見の通信が増える。値は仮の例（未検証）。Fast DDS 2.6 の initialAnnouncements を使う。
  tb3-meta: rmw=rmw_fastrtps_cpp
  tb3-meta: requires=
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <participant profile_name="tb3_multicast_fast_announce" is_default_profile="true">
    <rtps>
      <builtin>
        <discovery_config>
          <initialAnnouncements>
            <count>20</count>
            <period>
              <sec>0</sec>
              <nanosec>100000000</nanosec>
            </period>
          </initialAnnouncements>
        </discovery_config>
      </builtin>
    </rtps>
  </participant>
</profiles>
